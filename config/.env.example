# Example application environment variables
# Do not place real credentials, tokens, AWS access keys, or production endpoints in this file.

APP_ENV=development
APP_URL=https://example.com

DB_HOST=example-rds-endpoint.amazonaws.com
DB_PORT=3306
DB_NAME=wordpress
DB_USER=example_user
DB_PASSWORD=replace_me

S3_BUCKET=example-wordpress-assets
AWS_REGION=us-east-1

# Prefer IAM roles for AWS service access instead of static access keys.
